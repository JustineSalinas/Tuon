rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A study set is readable by a stranger only when its owner has explicitly
    // flipped `isShared`. Costs one document read per rule evaluation, which is
    // the accepted price for parent-driven access on a subcollection.
    //
    // Note there is deliberately no share *token*: rules cannot read query
    // parameters, so a token check would be client-side only — security
    // theatre. The real gate is this flag, plus a URL containing two
    // unguessable ids. Flipping the flag off revokes access immediately.
    function isSharedSet(userId, studySetId) {
      return get(/databases/$(database)/documents/users/$(userId)/studySets/$(studySetId))
        .data.get('isShared', false) == true;
    }

    // Fields the user is allowed to change from the client.
    // Everything else on the profile (plan, aiGenerationsUsedThisPeriod,
    // generationPeriodStart, lastGenerationAt, email, createdAt) is
    // server-owned and may only be written by the Admin SDK, which bypasses
    // these rules entirely.
    function onlyTouchesUserEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'educationLevel',
        'strand',
        'courses',
        'onboardingCompleted',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      // The profile document is bootstrapped server-side via the Admin SDK
      // (see /api/profile/bootstrap) so that plan + quota start from a
      // trusted state. Clients may never create it themselves.
      allow create: if false;
      allow update: if isOwner(userId) && onlyTouchesUserEditableFields();
      allow delete: if false;

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /studySets/{studySetId} {
        // `get` may be satisfied by sharing; `list` never can — a stranger must
        // not be able to enumerate someone's library even if one set is public.
        allow get: if isOwner(userId) || isSharedSet(userId, studySetId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);

        match /flashcards/{flashcardId} {
          allow read: if isOwner(userId) || isSharedSet(userId, studySetId);
          allow write: if isOwner(userId);
        }

        match /quizQuestions/{questionId} {
          allow read: if isOwner(userId) || isSharedSet(userId, studySetId);
          allow write: if isOwner(userId);
        }
      }

      match /reviewLogs/{flashcardId} {
        allow read, write: if isOwner(userId);
      }

      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
