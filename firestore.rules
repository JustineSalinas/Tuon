rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================================
       Identity
       ===================================================================== */

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /* =====================================================================
       Shape validation

       Rules must check *what* is written, not only *who* writes it. Without
       these, a signed-in client can write a 900KB note straight from devtools
       — no AI call, so the generation quota never engages — and the storage
       and read cost lands on us.

       Note counts cannot be limited here (rules cannot count documents);
       that is what App Check and signup rate limiting are for. These bounds
       cap the per-document damage.
       ===================================================================== */

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Optional string: present and short, or explicitly null.
    function isOptionalText(value, maxLength) {
      return value == null || isText(value, maxLength);
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    function isCount(value, maxValue) {
      return value is int && value >= 0 && value <= maxValue;
    }

    /* --- users/{uid} ---------------------------------------------------- */

    // Fields the user may change from the client. Everything else on the
    // profile — plan, planStatus, planExpiresAt, billingPeriod,
    // aiGenerationsUsedThisPeriod, generationPeriodStart, lastGenerationAt,
    // sessionsRevokedAt, email, createdAt — is server-owned and writable only
    // by the Admin SDK, which bypasses these rules. Without this the paywall
    // could be forged from the browser console: the billing webhook is the
    // only thing allowed to say that someone paid.
    function onlyTouchesUserEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'educationLevel',
        'strand',
        'school',
        'examDate',
        'courses',
        'semesters',
        'activeSemesterId',
        'onboardingCompleted',
        'timeZone',
        'dailyCardGoal',
        'typedRecall',
        'palette',
        'photoURL',
        'pomodoroFocus',
        'pomodoroShortBreak',
        'pomodoroLongBreak',
        'termsAcceptedVersion',
        'termsAcceptedAt',
        'isAdult',
        'guardianConsent',
        'updatedAt'
      ]);
    }

    function isPhaseMinutes(value) {
      return value is int && value >= 1 && value <= 120;
    }

    function validProfileEdit() {
      let d = request.resource.data;
      return isText(d.displayName, 80)
        && (d.educationLevel == null || d.educationLevel in ['grade_11', 'grade_12', 'college', 'board_review'])
        && (d.strand == null || d.strand in [
          'stem', 'abm', 'humss', 'gas',
          'tvl_he', 'tvl_ict', 'tvl_ia', 'tvl_afa',
          'sports', 'arts'
        ])
        && isOptionalText(d.get('school', null), 120)
        // YYYY-MM-DD or absent. A malformed value would silently disable the
        // exam clamp rather than erroring, so it is checked here.
        && (d.get('examDate', null) == null || d.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.courses is list
        && d.courses.size() <= 40
        // Terms, each carrying its own subject list. Bounded because this
        // rides on a document read on every page load, and rules cannot
        // look inside the entries — the client validates their shape, this
        // stops the array being used as storage.
        && (d.get('semesters', []) is list)
        && d.get('semesters', []).size() <= 16
        && isOptionalText(d.get('activeSemesterId', null), 64)
        && d.onboardingCompleted is bool
        && isOptionalText(d.get('timeZone', null), 64)
        && (d.get('dailyCardGoal', 0) is int)
        && (d.get('typedRecall', true) is bool)
        && isOptionalText(d.get('palette', null), 32)
        // A picture, inline. The ceiling matters: this document is read on
        // every page load, so an unbounded blob here would slow every
        // screen in the app. Mirrors MAX_AVATAR_CHARS.
        && isOptionalText(d.get('photoURL', null), 48000)
        // 1 to 120 minutes. A zero-length phase would complete instantly
        // and log blocks forever; a huge one would never end.
        && isPhaseMinutes(d.get('pomodoroFocus', 25))
        && isPhaseMinutes(d.get('pomodoroShortBreak', 5))
        && isPhaseMinutes(d.get('pomodoroLongBreak', 15))
        && validConsent();
    }

    // Consent is self-attested — nobody can verify a guardian from a browser.
    // What the rules CAN guarantee is that the record is honest about when it
    // was made: `termsAcceptedAt` must be the server's clock, not a date the
    // client picked, so an acceptance cannot be backdated.
    function validConsent() {
      let d = request.resource.data;
      return isOptionalText(d.get('termsAcceptedVersion', null), 32)
        && (d.get('isAdult', false) is bool)
        && (d.get('guardianConsent', false) is bool)
        && (
          // affectedKeys() is a Set: it answers hasAny/hasAll/hasOnly, not `in`.
          // The affectedKeys guard matters — without it, every later profile
          // edit would carry the original acceptance time forward and fail.
          // `.get` rather than `.termsAcceptedAt` because reading a field that
          // is not there is an evaluation error, not a false.
          !d.diff(resource.data).affectedKeys().hasAny(['termsAcceptedAt'])
          || d.get('termsAcceptedAt', null) == request.time
        );
    }

    /* --- notes ----------------------------------------------------------- */

    function validNote() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'content', 'courseTag', 'linkedTitles',
          'createdAt', 'updatedAt', 'lastGeneratedAt'
        ])
        && d.keys().hasAll(['title', 'content'])
        && isText(d.title, 140)
        // Ceiling across every plan. The per-plan limit (30k/60k/120k) is
        // enforced server-side in /api/generate, where the plan is known.
        && isText(d.content, 120000)
        && isOptionalText(d.get('courseTag', null), 80)
        && (d.get('linkedTitles', []) is list)
        && d.get('linkedTitles', []).size() <= 200;
    }

    /* --- study groups ----------------------------------------------------- */

    function validGroupSharedSet() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'ownerId', 'studySetId', 'title', 'courseTag',
          'cardCount', 'sharedByName', 'sharedAt'
        ])
        && d.keys().hasAll(['ownerId', 'studySetId', 'title'])
        && isText(d.ownerId, 64)
        && isText(d.studySetId, 64)
        && isText(d.title, 140)
        && isOptionalText(d.get('courseTag', null), 80)
        && isCount(d.get('cardCount', 0), 500)
        && isText(d.get('sharedByName', ''), 80);
    }

    function validGroupDeadline() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'dueDate', 'createdBy', 'createdByName', 'createdAt'
        ])
        && d.keys().hasAll(['title', 'dueDate'])
        && isText(d.title, 140)
        && d.title.size() > 0
        && isDayKey(d.dueDate)
        // Whoever wrote it has to be named honestly, or a member could post a
        // deadline in someone else's name.
        && d.get('createdBy', request.auth.uid) == request.auth.uid
        && isText(d.get('createdByName', ''), 80);
    }

    /**
     * A member's published standing.
     *
     * These numbers are computed on the member's own device from their own
     * review history — verifying them here would mean reading everyone's
     * private logs, which is a far worse trade in an invite-only group of
     * people who already know each other. What the rules CAN do is stop
     * anything absurd appearing, so the caps are the honest guarantee: a
     * forged score can be wrong, but it cannot be a billion.
     */
    function validGroupScore() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'displayName', 'photoURL', 'xp', 'recalls', 'mastered',
          'studied', 'updatedAt'
        ])
        && isText(d.get('displayName', ''), 80)
        && isOptionalText(d.get('photoURL', null), 48000)
        && isCount(d.get('xp', 0), 1000000)
        && isCount(d.get('recalls', 0), 1000000)
        && isCount(d.get('mastered', 0), 100000)
        && isCount(d.get('studied', 0), 100000);
    }

    function validGroupPresence() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'until', 'updatedAt'])
        && isText(d.get('displayName', ''), 80)
        && d.until is timestamp
        // A presence entry that never expires is a member who appears to be
        // studying forever. Two hours is well past any real focus block.
        && d.until < request.time + duration.value(2, 'h');
    }

    /* --- the organiser --------------------------------------------------- */

    // One collection with a `kind` discriminator: the calendar wants todos,
    // deadlines and classes on one screen, and three subscriptions to three
    // tiny collections is three times the work for the same result. The cost
    // is that this validator has to branch, which is what the three helpers
    // below are for.
    function validPlanItem() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'kind', 'title', 'courseTag', 'dueDate', 'done',
          'weekday', 'startMinute', 'endMinute', 'location',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['kind', 'title'])
        && d.kind in ['todo', 'deadline', 'class']
        && isText(d.title, 140)
        && d.title.size() > 0
        && isOptionalText(d.get('courseTag', null), 80)
        && (d.kind == 'todo' ? validTodo(d) : true)
        && (d.kind == 'deadline' ? validDeadline(d) : true)
        && (d.kind == 'class' ? validClass(d) : true);
    }

    // A calendar day in the student's own zone, never an instant. Pushing it
    // through UTC moves it a day for everyone in Manila - same reasoning as
    // examDate on the profile, and the same regex.
    function isDayKey(value) {
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTodo(d) {
      return (d.get('dueDate', null) == null || isDayKey(d.dueDate))
        && (d.get('done', false) is bool);
    }

    function validDeadline(d) {
      // A deadline without a date is not a deadline; it is a todo, and there
      // is already a kind for that.
      return d.get('dueDate', null) != null
        && isDayKey(d.dueDate);
    }

    function validClass(d) {
      return d.get('weekday', -1) is int
        && d.weekday >= 0 && d.weekday <= 6
        && d.get('startMinute', -1) is int
        && d.get('endMinute', -1) is int
        && d.startMinute >= 0 && d.startMinute < 1440
        && d.endMinute > 0 && d.endMinute <= 1440
        // A class that ends before it starts would render as a negative-height
        // block and sort unpredictably against everything else that day.
        && d.endMinute > d.startMinute
        && isOptionalText(d.get('location', null), 80);
    }

    // Minutes actually studied. `minutes` is stored rather than derived from
    // the timestamps because an edited session no longer matches them, and
    // being editable is the whole point: a student who studied offline and
    // sees a blank week stops believing the number.
    function validStudySession() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'source', 'day', 'minutes', 'courseTag', 'cardsReviewed',
          'startedAt', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['source', 'day', 'minutes'])
        && d.source in ['pomodoro', 'review', 'manual']
        && isDayKey(d.day)
        // Twelve hours. Beyond that it is a timer left running overnight, and
        // one bad row poisons every average built on the log.
        && isCount(d.minutes, 720)
        && isOptionalText(d.get('courseTag', null), 80)
        && (d.get('cardsReviewed', null) == null || isCount(d.cardsReviewed, 100000));
    }

    /* --- study sets ------------------------------------------------------ */

    function validStudySet() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'noteId', 'title', 'courseTag', 'flashcardCount', 'quizQuestionCount',
          'source', 'isShared', 'sharedWithGroups', 'createdAt'
        ])
        && d.keys().hasAll(['title', 'flashcardCount', 'quizQuestionCount'])
        && isText(d.title, 140)
        && isOptionalText(d.get('noteId', null), 64)
        && isOptionalText(d.get('courseTag', null), 80)
        && isCount(d.flashcardCount, 500)
        && isCount(d.quizQuestionCount, 100)
        && (d.get('source', 'manual') in ['ai', 'manual'])
        && (d.get('isShared', false) is bool)
        // Groups the owner has put this set into. Naming a group they are not
        // in only ever exposes their OWN set to that group, which is their
        // call; the cap stops the list being used as free storage.
        && (d.get('sharedWithGroups', []) is list)
        && d.get('sharedWithGroups', []).size() <= 20;
    }

    // `ownerId` is denormalised onto every card so the review queue can read
    // them all in one collection-group query. It is therefore an access-control
    // field, not a convenience: it MUST equal the owning path, or one student
    // could plant a card that shows up in another student's queue.
    function validFlashcard(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['front', 'back', 'order', 'ownerId'])
        && d.keys().hasAll(['front', 'back'])
        && isText(d.front, 400)
        && isText(d.back, 1200)
        && d.front.size() > 0
        && d.back.size() > 0
        && isCount(d.get('order', 0), 1000)
        && d.get('ownerId', userId) == userId;
    }

    function validQuizQuestion() {
      let d = request.resource.data;
      return d.keys().hasOnly(['question', 'choices', 'correctIndex', 'order', 'flashcardId'])
        && d.keys().hasAll(['question', 'choices', 'correctIndex'])
        // Which card this question tests. Null on older sets and on questions
        // whose card was dropped in normalisation.
        && isOptionalText(d.get('flashcardId', null), 64)
        && isText(d.question, 600)
        && d.choices is list
        && d.choices.size() >= 2
        && d.choices.size() <= 6
        && d.correctIndex is int
        && d.correctIndex >= 0
        && d.correctIndex < d.choices.size()
        && isCount(d.get('order', 0), 1000);
    }

    /* --- review logs ------------------------------------------------------
       SM-2 runs on the client, so the client legitimately writes these.
       Bounding the values stops a tampered client from writing nonsense
       scheduling state (or gaming the retention stats).
       -------------------------------------------------------------------- */

    function validReviewLog() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'flashcardId', 'studySetId', 'easeFactor', 'intervalDays',
          'repetitions', 'nextReviewAt', 'lastReviewedAt', 'lastRating'
        ])
        && isText(d.flashcardId, 64)
        && isText(d.studySetId, 64)
        && d.easeFactor is number
        && d.easeFactor >= 1.3
        && d.easeFactor <= 5.0
        // 100 years is well past any real interval, and stops a client
        // parking a card beyond the heat death of the schedule.
        && isCount(d.intervalDays, 36500)
        && isCount(d.repetitions, 10000)
        && isTimestamp(d.nextReviewAt)
        && d.lastRating in ['again', 'hard', 'good', 'easy'];
    }

    // A student flagging a generated card as wrong. Tiny and append-only:
    // the id IS the flashcard id, so one card cannot be reported twice, and
    // there is nothing here worth forging.
    function validCardReport(flashcardId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['studySetId', 'flashcardId', 'reportedAt'])
        && isText(d.studySetId, 64)
        && d.flashcardId == flashcardId
        && d.reportedAt == request.time;
    }

    function validQuizAttempt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['studySetId', 'studySetTitle', 'score', 'total', 'completedAt'])
        && isText(d.studySetId, 64)
        && isOptionalText(d.get('studySetTitle', null), 140)
        && isCount(d.score, 1000)
        && isCount(d.total, 1000)
        && d.score <= d.total;
    }

    /* =====================================================================
       Sharing

       A study set is readable by a stranger only when its owner has flipped
       `isShared`. Costs one document read per rule evaluation, which is the
       accepted price for parent-driven access on a subcollection.

       There is deliberately no share *token*: rules cannot read query
       parameters, so a token check would be client-side only — security
       theatre. The real gate is this flag plus a URL containing two
       unguessable ids. Flipping it off revokes access immediately.
       ===================================================================== */

    /* --- study groups ----------------------------------------------------

       Group data is the first thing in Tuón that more than one account can
       read, so the access rules are worth stating plainly:

       * `memberIds` on the group document IS the access-control list. It is
         server-owned - only /api/groups/* writes it - because a client that
         could edit it could add itself to any group whose id it could guess.
       * `groupIds` on a profile is the same list from the other side, also
         server-owned, and exists so a set shared into a group can be read
         without the reader having to enumerate anything.
       * Nothing here is public. There is no listing of groups, no discovery,
         and no way to see a group you are not in.
       -------------------------------------------------------------------- */

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/studyGroups/$(groupId));
    }

    function isGroupMember(groupId) {
      return request.auth != null
        && request.auth.uid in groupDoc(groupId).data.get('memberIds', []);
    }

    function isGroupOwner(groupId) {
      return request.auth != null
        && groupDoc(groupId).data.get('ownerId', '') == request.auth.uid;
    }

    /** The groups the CALLER belongs to, from their own profile. */
    function myGroupIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('groupIds', []);
    }

    /**
     * A set the owner has put into a group the caller is also in.
     *
     * Deliberately narrower than the link-share above: `isShared` means anyone
     * with the URL, while this means exactly the members of the named groups.
     * Sharing to a group must not quietly publish a set to the internet.
     */
    function isSharedToMyGroup(userId, studySetId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(userId)/studySets/$(studySetId))
             .data.get('sharedWithGroups', []).hasAny(myGroupIds());
    }

    function isSharedSet(userId, studySetId) {
      return get(/databases/$(database)/documents/users/$(userId)/studySets/$(studySetId))
        .data.get('isShared', false) == true;
    }

    /* =====================================================================
       Collections
       ===================================================================== */

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      // Bootstrapped server-side (/api/profile/bootstrap) so plan and quota
      // start from a trusted state. Clients may never create it.
      allow create: if false;
      allow update: if isOwner(userId)
        && onlyTouchesUserEditableFields()
        && validProfileEdit();
      // Deletion goes through the Admin SDK so subcollections are removed too.
      allow delete: if false;

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validNote();
        allow delete: if isOwner(userId);
      }

      match /studySets/{studySetId} {
        // `get` may be satisfied by sharing; `list` never can — a stranger
        // must not be able to enumerate a library even if one set is public.
        allow get: if isOwner(userId)
          || isSharedSet(userId, studySetId)
          || isSharedToMyGroup(userId, studySetId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && validStudySet();
        allow delete: if isOwner(userId);

        match /flashcards/{flashcardId} {
          allow read: if isOwner(userId)
            || isSharedSet(userId, studySetId)
            || isSharedToMyGroup(userId, studySetId);
          allow create, update: if isOwner(userId) && validFlashcard(userId);
          allow delete: if isOwner(userId);
        }

        match /quizQuestions/{questionId} {
          allow read: if isOwner(userId)
            || isSharedSet(userId, studySetId)
            || isSharedToMyGroup(userId, studySetId);
          allow create, update: if isOwner(userId) && validQuizQuestion();
          allow delete: if isOwner(userId);
        }
      }

      match /planItems/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPlanItem();
        allow delete: if isOwner(userId);
      }

      match /studySessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validStudySession();
        allow delete: if isOwner(userId);
      }

      match /reviewLogs/{flashcardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validReviewLog();
        allow delete: if isOwner(userId);
      }

      match /cardReports/{flashcardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCardReport(flashcardId);
        allow delete: if isOwner(userId);
      }

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validQuizAttempt();
        allow update, delete: if isOwner(userId);
      }
    }

    /* =====================================================================
       Study groups

       Invite-only, and deliberately not public rooms. Tuón's core audience is
       Grade 11 and 12 - minors - and a public room would put them in a live
       space with adult strangers, making this app responsible for moderation,
       reporting and blocking. Everything below is scoped to people who already
       know each other and joined by an invite one of them sent.

       There is no `list` on studyGroups anywhere. A student reaches their own
       groups through `groupIds` on their profile; nobody can enumerate groups,
       search them, or discover one they were not invited to.
       ===================================================================== */

    match /studyGroups/{groupId} {
      // Membership is the whole access rule, and it is on the document itself.
      allow get: if isGroupMember(groupId);
      /**
       * A query is a list operation, so a student fetching the handful of
       * groups on their own profile needs this — reading them one at a time
       * would be a request per group on every page load.
       *
       * It is not a discovery hole. Rules are not filters: a query is refused
       * unless EVERY document it would return satisfies the rule, so an
       * unconstrained "give me all groups" fails the moment it touches one the
       * caller is not in. The only queries that succeed are ones already
       * narrowed to their own groups. Asserted both ways in the rules tests.
       */
      allow list: if request.auth != null
        && request.auth.uid in resource.data.get('memberIds', []);

      // Created and destroyed through /api/groups/*, which writes the group,
      // the member record and the creator's profile together. A half-created
      // group is a group with no members that nobody can ever reach.
      allow create, delete: if false;

      // The owner may rename it. `memberIds`, `ownerId` and `memberCount` are
      // the access-control list and stay server-owned: a client that could
      // edit them could add itself to any group whose id it could guess.
      allow update: if isGroupOwner(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'courseTag', 'updatedAt'])
        && isText(request.resource.data.name, 80)
        && request.resource.data.name.size() > 0
        && isOptionalText(request.resource.data.get('courseTag', null), 80);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        // Server-written on join and leave, for the same reason as memberIds.
        allow write: if false;
      }

      match /sharedSets/{sharedSetId} {
        allow read: if isGroupMember(groupId);
        // You may share your own set into a group you are in, and nothing
        // else. Without the ownerId check a member could list someone else's
        // set, which would not grant access but would be a convincing lie.
        allow create: if isGroupMember(groupId)
          && request.resource.data.ownerId == request.auth.uid
          && validGroupSharedSet();
        allow update: if false;
        // The person who shared it, or the group owner tidying up.
        allow delete: if isGroupMember(groupId)
          && (resource.data.ownerId == request.auth.uid || isGroupOwner(groupId));
      }

      match /deadlines/{deadlineId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId) && validGroupDeadline();
        allow delete: if isGroupMember(groupId);
      }

      match /scores/{memberId} {
        allow read: if isGroupMember(groupId);
        // Only your own row. Writing someone else's would let a member put a
        // classmate at the bottom of the table.
        allow create, update: if isGroupMember(groupId)
          && memberId == request.auth.uid
          && validGroupScore();
        allow delete: if isGroupMember(groupId) && memberId == request.auth.uid;
      }

      match /presence/{memberId} {
        allow read: if isGroupMember(groupId);
        // Only ever your own, and only what a presence entry is allowed to
        // say. Writing someone else's would let a member fake company.
        allow create, update: if isGroupMember(groupId)
          && memberId == request.auth.uid
          && validGroupPresence();
        // Delete is listed separately because there is no incoming document to
        // validate: `allow write` covered it, and validGroupPresence() then
        // failed on a request that has no `resource` to check. The symptom was
        // a member who stopped their timer and stayed lit until the entry
        // expired on its own.
        allow delete: if isGroupMember(groupId) && memberId == request.auth.uid;
      }
    }

    /* Invite codes are resolved server-side by /api/groups/join. A client that
       could read this collection could enumerate every code and walk into any
       group; a client that could write it could mint one. */
    match /groupInvites/{code} {
      allow read, write: if false;
    }

    /* =====================================================================
       Collection-group read

       The review queue, calendar, and stats all need every card the student
       owns. Walking studySets one at a time cost one query per set; this
       serves all of them in one. It grants nothing extra: `ownerId` is
       pinned to the owning path by validFlashcard, so this matches exactly
       the cards the per-set rule above already allows the owner to read.

       Read only — writes still go through the path-scoped rule.
       ===================================================================== */

    /* =====================================================================
       Server-owned collections

       `billingEvents` is the webhook's idempotency ledger and `reports` is the
       moderation queue; `rateLimits` is the anti-farming counter. All three
       are Admin-SDK-only — they fall through to the catch-all deny below, and
       tests assert that. They are named here so it is a decision rather than
       an omission.
       ===================================================================== */

    match /{path=**}/flashcards/{flashcardId} {
      allow read: if request.auth != null
        && resource.data.get('ownerId', '') == request.auth.uid;
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
