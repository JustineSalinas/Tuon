# Copy to .env.local and fill in.

# --- Firebase Web SDK (public, browser-safe) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only) ---
# Full service-account JSON on one line, single-quoted.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Firebase App Check (optional until you enable it) ---
# reCAPTCHA Enterprise site key from the Firebase console.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Set to "true" only once the client is issuing tokens, or every request 403s.
APP_CHECK_ENFORCED=

# --- PayMongo (server only) ---
# sk_test_... while testing; sk_live_... switches the code to live mode and
# makes it verify the `li` half of the webhook signature instead of `te`.
PAYMONGO_SECRET_KEY=
# The webhook's own secret (whsk_...), returned when you create the webhook.
# NOT the secret key above — signature verification fails silently if you
# paste the wrong one, and every payment then looks forged.
PAYMONGO_WEBHOOK_SECRET=

# --- Rate limits (optional; sane defaults are compiled in) ---
# Requests per hour, per IP address. Kept out of source so the thresholds
# aren't readable, and so you can tighten one under attack without a redeploy.
RATE_LIMIT_BOOTSTRAP=
RATE_LIMIT_GENERATE=
RATE_LIMIT_ACCOUNT_DELETE=
RATE_LIMIT_REPORT=
RATE_LIMIT_CHECKOUT=
RATE_LIMIT_SEND_VERIFICATION=
# The landing-page assistant. Anonymous and paid, so keep this tight.
RATE_LIMIT_CHAT=

# --- Transactional email ---
# Without these, verification mail falls back to Firebase's own mailer, which
# sends from noreply@<project>.firebaseapp.com. That domain is shared by every
# Firebase project, has no SPF/DKIM/DMARC alignment to anything we control, and
# Gmail files it as spam on that pooled reputation alone. The fallback keeps
# signup working; it does not keep it out of the spam folder.
#
# To fix delivery properly you need BOTH of these AND a domain you own, added
# and verified in the provider with the SPF, DKIM and DMARC records it gives
# you. Sending from an unverified domain will be rejected outright.
RESEND_API_KEY=
# Must be on the verified domain, e.g. "Tuon <noreply@yourdomain.com>".
EMAIL_FROM=
# Optional. A real inbox someone reads; a dead reply-to costs you trust.
EMAIL_REPLY_TO=

# --- Diagnostics ---
# Gates the detailed part of /api/health in production. Liveness (ready + the
# status code an uptime monitor needs) stays public either way; the per-check
# detail requires this value in an `x-health-token` header.
#
# Unset means the detail is NEVER served in production, not that it is open —
# the endpoint shipped open once and an audit found it advertising that App
# Check was disabled. Any long random string works: `openssl rand -hex 32`.
HEALTH_TOKEN=

# --- Deployment ---
# Canonical origin for sitemap, robots, and Open Graph URLs.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=
